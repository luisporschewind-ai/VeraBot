# VeraBot 后端配置。start.sh 首次运行时会复制为 .env 并提示填写 DeepSeek Key。
# .env 已被 .gitignore 忽略，切勿提交真实密钥。已导出的环境变量优先于 .env。

# 必填：DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 可选：语音转写（Web 端 /api/transcribe，OpenAI gpt-4o-mini-transcribe / whisper-1）
OPENAI_API_KEY=

# 可选（以下为默认值）
# HOST=0.0.0.0
# PORT=8000
# DEEPSEEK_MODEL=deepseek-flash
# VERABOT_DEEPSEEK_THINKING=0          # 1 = 不发 thinking:disabled（需先实现 reasoning_content 回传）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# VERABOT_DATA_DIR=./data             # SQLite 数据库、JWT 密钥、本地模型
# VERABOT_JWT_SECRET=                 # 留空则自动生成并保存在 data/.jwt_secret
# 账号 v9（docs/design/AUTH_REFACTOR.md §6）
# VERABOT_TOKEN_TTL_HOURS=168         # 访问令牌 7 天
# VERABOT_REFRESH_TTL_DAYS=60         # 刷新令牌（每次刷新轮换）
# VERABOT_AUTH_CODE_TTL=600           # 邮箱验证码有效秒数
# VERABOT_AUTH_CODE_COOLDOWN=60       # 同一邮箱两次发码间隔（秒）
# VERABOT_AUTH_CODE_DAILY=10          # 同一邮箱每天最多发码次数
# VERABOT_AUTH_IP_LIMIT=30            # 同一 IP 10 分钟内注册 + 登录失败上限
# VERABOT_MAIL_BACKEND=console        # console：验证码写进后端日志（开发）；smtp：真实发信
# VERABOT_SMTP_HOST=smtp.gmail.com
# VERABOT_SMTP_PORT=587               # 465 时设 VERABOT_SMTP_SSL=1
# VERABOT_SMTP_USER=                  # 例如 luisporschewind@gmail.com
# VERABOT_SMTP_PASSWORD=              # Gmail 应用专用密码（不是登录密码）
# VERABOT_SMTP_FROM=                  # 默认同 USER
# VERABOT_SMTP_STARTTLS=1
# VERABOT_SMTP_SSL=0
# VERABOT_SMTP_TIMEOUT=15
# MAX_BOTS_PER_USER=20                # Bot 数量软上限
# VERABOT_DAILY_TOKEN_QUOTA=200000    # 每用户每日 Token 预算
# VERABOT_MAX_DELEGATION_DEPTH=1
# VERABOT_MAX_DELEGATIONS_PER_TURN=3
# VERABOT_MAX_SHARED_CONTEXT=2000
# VERABOT_TZ=Asia/Shanghai
# VERABOT_WEB_DIR=../frontend/web     # Web 客户端目录；不存在时只提供 API
# VERABOT_LOCAL_STT=1                 # 已安装 local-stt 额外依赖时，OpenAI 失败自动回退本地模型；0 关闭
# VERABOT_LOCAL_STT_MODEL=small
# VERABOT_MEMORY=1                   # 长期记忆总开关；0 关闭（不召回、不暴露记忆工具）
# VERABOT_MEMORY_ENC_KEY=             # 健康 / 财务记忆的 Fernet 密钥；留空则自动生成并保存在 data/.memory_key（与数据库分开备份）
# VERABOT_MEMORY_VECTOR=1              # 本地语义召回；需安装 uv sync --extra memory-vector，模型首次使用时缓存到 data/models/memory
# VERABOT_MEMORY_VECTOR_MODEL=BAAI/bge-small-zh-v1.5
# VERABOT_MEMORY_VECTOR_MIN_SIMILARITY=0.25
# MCP M1（免授权目录；不在此写密钥）。地址留空字符串表示未配置。
# VERABOT_MCP_LEARN_URL=https://learn.microsoft.com/api/mcp
# VERABOT_MCP_LEARN_ENABLED=1         # 不再预装。新用户的已安装列表为空；装上之后才用这个地址同步
# VERABOT_MCP_AWS_URL=https://knowledge-mcp.global.api.aws
# VERABOT_MCP_AWS_ENABLED=0           # 不再预装，也不再自动建停用行。地址留空则目录里显示「服务地址未配置」
# VERABOT_MCP_PROTOCOL_VERSION=2025-06-18
# VERABOT_MCP_TIMEOUT=15              # 秒，单次 HTTP 超时，建议 10–15
# VERABOT_MCP_RETRY_MAX=2             # 超时 / 5xx / 连接失败的额外重试次数（不含第一次）
# VERABOT_MCP_RETRY_BACKOFF=0.5,2     # 秒，按次数取，另加最多 25% 抖动。429 则优先用 Retry-After（上限 5 秒）
# VERABOT_MCP_BREAKER_THRESHOLD=5     # 同一服务连续传输失败这么多次后打开熔断
# VERABOT_MCP_BREAKER_COOLDOWN=60     # 秒。打开期间不发请求；到期后放行一次探测
# VERABOT_MCP_CALLS_PER_TURN=8
# VERABOT_MCP_PENDING_PER_TURN=2      # 单轮最多创建这么多待确认操作（MCP M3）
# VERABOT_ACTION_TTL_MIN=15           # 待确认操作过期分钟数
# VERABOT_ACTION_ENC_KEY=             # 冻结参数 Fernet 密钥；留空则自动生成 data/.action_key（建议与数据库一起备份）
# VERABOT_MCP_MAX_RESULT_CHARS=8000
# VERABOT_MCP_MAX_TOOLS_PER_SERVER=50
# --- 需授权连接器（GitHub / Linear，schema v13） ---
# VERABOT_TOKEN_ENC_KEY=              # 连接器令牌的 Fernet 密钥；留空则自动生成 data/.token_key（必须与数据库一起备份）
# VERABOT_ALLOW_LAN_CREDENTIALS=0     # 1 = 允许经局域网明文 HTTP 上传令牌（默认只允许 127.0.0.1 / HTTPS）
# VERABOT_MCP_GITHUB_URL=https://api.githubcopilot.com/mcp/readonly
# VERABOT_GITHUB_API_URL=https://api.github.com   # 只用来读账号名与令牌到期时间
# VERABOT_MCP_LINEAR_URL=https://mcp.linear.app/mcp/readonly
# VERABOT_MCP_LIVE_TESTS=1            # 仅测试：1 时 mcp_test.py 才请求上面两个公网地址
# 以下两项需在运行 start.sh 前 export（安装依赖时 .env 尚未读取）：
# VERABOT_PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple   # 官方源失败时使用的 PyPI 镜像
# VERABOT_FORCE_MIRROR=1              # 直接使用镜像安装（跳过官方源）
