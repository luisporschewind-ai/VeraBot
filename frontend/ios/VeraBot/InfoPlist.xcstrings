    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VeraBot needs local network access to reach your VeraBot server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VeraBot 需要访问局域网内的 VeraBot 服务器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VeraBot uses the microphone for voice input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VeraBot 需要使用麦克风进行中文语音输入。"
